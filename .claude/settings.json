{
  "permissions": {
    "allow": [
      "Read(//**)",
      "Edit(//**)",
      "Write(//**)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(pytest:*)",
      "Bash(black:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(python:*)",
      "Bash(pip list)",
      "Bash(pip show:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/post_edit.py",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/on_stop.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
